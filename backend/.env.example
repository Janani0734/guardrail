# Copy to .env and adjust. Never commit the real .env.
APP_NAME=GuardRail
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://guardrail:guardrail@localhost:5432/guardrail
REDIS_URL=redis://localhost:6379/0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
API_KEY_PEPPER=change-me-too-another-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
APPROVAL_TTL_MINUTES=30
APPROVAL_TOKEN_TTL_SECONDS=900
DEFAULT_RATE_LIMIT_PER_MINUTE=60
DEFAULT_REPEAT_THRESHOLD=3
DEFAULT_REPEAT_WINDOW_SECONDS=600
DEFAULT_REPEAT_BLOCK_SECONDS=300
WORKER_ENABLED=true
WORKER_INTERVAL_SECONDS=15
ANALYTICS_CACHE_TTL_SECONDS=30
CORS_ORIGINS=["http://localhost:3000"]
BCRYPT_ROUNDS=12
